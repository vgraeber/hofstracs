use std::mem::{swap,replace,take};
use std::collections::{HashSet,HashMap};
use std::hash::Hash;

fn flap<T>(v:&Vec<T>) -> Vec<&T> {
	let mut fl:Vec<&T> = Vec::new();
	let mut i = 0;
	let mut j = v.len() - 1;
	let k = v.len() / 2;
	while (i < k) {
		i += 1;
		fl.push(&v[k-i]);
	}
	if (k % 2 == 0) {
		fl.push(&v[k]);
	}
	while (j > k) {
		fl.push(&v[j]);
		j -= 1;
	}
	return fl;
}

fn count<T>(v:&[T]) -> i32 {
	let mut i = 0;
	for x in 0..v.len() {
		i += 1;
	}
	return i;
}

fn union<'t,'u,T:Eq>(v1:&'t Vec<T>, v2:&'u Vec<T>) -> Vec<&'t T> {
	let mut uv = Vec::new();
	let mut dup = Vec::new();
	for x in 0..v1.len() {
		for y in 0..v2.len() {
			if (&v1[x] == &v2[y]) {
				let t1 = count(&v1[..]);
				let t2 = count(&v2[..]);
				dup.push(&v1[x]);
			}
		}
	}
	let mut i = 0;
	for x in 0..v1.len() {
		
	}
	return uv;
}

